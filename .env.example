# ==============================================================================
# urtp (uring-rtp) Environment Configuration Template
#
# Canonical environment variable reference for urtp daemon and Docker Compose.
# Copy this file to .env or use with:
#   docker compose --env-file <file> up -d
# ==============================================================================

# Active Compose Environment File
ENV_FILE=.env

# ------------------------------------------------------------------------------
# Control Plane Configuration
# ------------------------------------------------------------------------------
# Path to Unix domain socket for local control plane. Set to empty or 'none' to disable.
URTP_CONTROL_SOCK=/var/run/urtp.sock

# Kamailio / OpenSIPS ng control protocol port (bencode over UDP)
URTP_CONTROL_NG=22222

# TCP control protocol & Prometheus HTTP metrics endpoint (GET /metrics)
URTP_CONTROL_TCP=22222

# Media IPv4/IPv6 address to bind and advertise in SDP negotiations
URTP_MEDIA_IP=0.0.0.0

# ------------------------------------------------------------------------------
# Telemetry & Observability
# ------------------------------------------------------------------------------
# Periodic metrics logging interval in seconds (0 = disabled, e.g. 10)
URTP_METRICS_INTERVAL=10

# ------------------------------------------------------------------------------
# Real-Time Audio Transcoding & Jitter Buffer
# ------------------------------------------------------------------------------
# Transcoding backend: 'none', 'libopus', or 'ffmpeg'
URTP_TRANSCODER=none

# Target / default transcoding codec: 'auto', 'pcmu', 'pcma', 'opus', 'none'
URTP_TRANSCODE_CODEC=auto

# Jitter buffer delay in milliseconds (0 = disabled, recommended: 40ms for transcoding)
URTP_JITTER_BUFFER=0

# ------------------------------------------------------------------------------
# Forensic PCAP Call Recording
# ------------------------------------------------------------------------------
# Container directory path where PCAP capture files are written. Unset = disabled.
URTP_RECORD_DIR=

# Automatically capture all media streams to disk without explicit RECORD command
URTP_RECORD_ALL=false

# Host directory mapped to container's /pcap mount point
PCAP_HOST_DIR=./pcap

# ------------------------------------------------------------------------------
# io_uring Asynchronous I/O Engine Tuning
# ------------------------------------------------------------------------------
# Number of submission / completion queue entries (must be a power of 2, e.g. 1024, 4096)
URTP_ENTRIES=1024

# Number of provided buffer ring entries (must be a power of 2, e.g. 2048, 8192)
URTP_BUFFERS=2048

# Enable io_uring kernel submission polling thread (SQPOLL). Requires CAP_SYS_NICE.
URTP_SQPOLL=false

# ------------------------------------------------------------------------------
# Watchdog & Session Lifecycles (seconds)
# ------------------------------------------------------------------------------
# Graceful shutdown drain timeout
URTP_SHUTDOWN_TIMEOUT=30

# Inactive session reaper timeout
URTP_INACTIVITY_TIMEOUT=60

# Pending setup / handshake timeout
URTP_SETUP_TIMEOUT=30
