# ==============================================================================
# urtp (uring-rtp) - Transcoding & Adaptive Jitter Buffer Profile
#
# Real-time audio transcoding (WebRTC Opus <-> SIP/PSTN G.711 PCMU/PCMA)
# coupled with a 40ms adaptive jitter buffer and native Packet Loss
# Concealment (PLC).
#
# Usage:
#   docker compose --env-file .env.transcode up -d
#   # or: ENV_FILE=.env.transcode docker compose up -d
# ==============================================================================

ENV_FILE=.env.transcode

# Control Plane Ports
URTP_CONTROL_NG=22222
URTP_CONTROL_TCP=22222
URTP_MEDIA_IP=0.0.0.0

# Periodic Metrics Telemetry (seconds)
URTP_METRICS_INTERVAL=10

# Real-Time Audio Transcoding & Jitter Buffer
URTP_TRANSCODER=libopus
URTP_TRANSCODE_CODEC=auto
URTP_JITTER_BUFFER=40

# Forensic Recording (disabled by default in transcode-only)
URTP_RECORD_DIR=
URTP_RECORD_ALL=false
PCAP_HOST_DIR=./pcap

# io_uring Engine Configuration
URTP_ENTRIES=1024
URTP_BUFFERS=2048
URTP_SQPOLL=false
