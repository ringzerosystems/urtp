{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CC": "clang",
        "PKG_CONFIG_PATH": "$env{HOME}/.local/lib/x86_64-linux-gnu/pkgconfig:$env{HOME}/.local/lib/pkgconfig:$penv{PKG_CONFIG_PATH}"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "URTP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Clang Debug",
      "description": "Debug build with Clang, strict warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "URTP_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Clang Release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "URTP_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Clang Sanitize",
      "description": "Debug build with ASan and UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "URTP_ENABLE_ASAN": "ON",
        "URTP_ENABLE_UBSAN": "ON",
        "URTP_ENABLE_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "test-release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "test-sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
