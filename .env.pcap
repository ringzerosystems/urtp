# ==============================================================================
# urtp (uring-rtp) - Forensic PCAP Call Recording Profile
#
# Captures all incoming and forwarded RTP/RTCP media packets directly to
# disk in standard libpcap format for forensic analysis and compliance.
#
# Usage:
#   docker compose --env-file .env.pcap up -d
#   # or: ENV_FILE=.env.pcap docker compose up -d
# ==============================================================================

ENV_FILE=.env.pcap

# Control Plane Ports
URTP_CONTROL_NG=22222
URTP_CONTROL_TCP=22222
URTP_MEDIA_IP=0.0.0.0

# Periodic Metrics Telemetry (seconds)
URTP_METRICS_INTERVAL=10

# Media Processing (pure zero-copy forwarding)
URTP_TRANSCODER=none
URTP_JITTER_BUFFER=0

# Forensic Call Recording
URTP_RECORD_DIR=/pcap
URTP_RECORD_ALL=true
PCAP_HOST_DIR=./pcap

# io_uring Engine Configuration
URTP_ENTRIES=1024
URTP_BUFFERS=2048
URTP_SQPOLL=false
