# ==============================================================================
# urtp (uring-rtp) - Full Feature Suite Profile
#
# Complete feature suite enabled:
# - WebRTC Opus <-> SIP/PSTN G.711 real-time audio transcoding
# - Adaptive 40ms jitter buffer with Packet Loss Concealment (PLC)
# - Continuous forensic PCAP packet recording to ./pcap
# - Real-time Prometheus and Grafana observability stack
#
# Usage:
#   docker compose --env-file .env.full up -d
#   # or: ENV_FILE=.env.full docker compose up -d
# ==============================================================================

ENV_FILE=.env.full

# Control Plane Ports
URTP_CONTROL_NG=22222
URTP_CONTROL_TCP=22222
URTP_MEDIA_IP=0.0.0.0

# Periodic Metrics Telemetry (seconds)
URTP_METRICS_INTERVAL=10

# Real-Time Audio Transcoding & Jitter Buffer
URTP_TRANSCODER=libopus
URTP_TRANSCODE_CODEC=auto
URTP_JITTER_BUFFER=40

# Continuous Forensic PCAP Recording
URTP_RECORD_DIR=/pcap
URTP_RECORD_ALL=true
PCAP_HOST_DIR=./pcap

# io_uring Engine Configuration
URTP_ENTRIES=1024
URTP_BUFFERS=2048
URTP_SQPOLL=false
