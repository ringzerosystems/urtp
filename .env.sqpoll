# ==============================================================================
# urtp (uring-rtp) - High-Throughput Kernel SQPOLL Profile
#
# Dedicated kernel submission polling thread (SQPOLL) with scaled ring entries
# and provided buffers for 100k+ packets/sec ultra-low latency media routing.
# Requires SYS_NICE capability (configured in docker-compose.yml).
#
# Usage:
#   docker compose --env-file .env.sqpoll up -d
#   # or: ENV_FILE=.env.sqpoll docker compose up -d
# ==============================================================================

ENV_FILE=.env.sqpoll

# Control Plane Ports
URTP_CONTROL_NG=22222
URTP_CONTROL_TCP=22222
URTP_MEDIA_IP=0.0.0.0

# Periodic Metrics Telemetry (seconds)
URTP_METRICS_INTERVAL=10

# Media Processing (pure zero-copy forwarding)
URTP_TRANSCODER=none
URTP_JITTER_BUFFER=0

# Forensic Recording (disabled for maximum throughput)
URTP_RECORD_DIR=
URTP_RECORD_ALL=false
PCAP_HOST_DIR=./pcap

# High-Performance io_uring Ring Tuning
URTP_ENTRIES=4096
URTP_BUFFERS=8192
URTP_SQPOLL=true
